<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@android:color/black"
    android:gravity="center">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/appwidget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🌤️ IMD Portal"
            android:textColor="#BB86FC"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:background="#333333" />

    <!-- C-Off Balance -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:id="@+id/appwidget_coff_balance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--"
            android:textColor="#03DAC6"
            android:textSize="36sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/appwidget_coff_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="C-Off Days"
            android:textColor="#AAAAAA"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Footer: Last Synced -->
    <TextView
        android:id="@+id/appwidget_last_synced"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Last Synced: Never"
        android:textColor="#777777"
        android:textSize="9sp"
        android:gravity="center" />

</LinearLayout>
