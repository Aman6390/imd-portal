<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/widget_background"
    android:gravity="center">

    <!-- Header -->
    <TextView
        android:id="@+id/appwidget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="IMD Portal"
        android:textColor="#BB86FC"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- C-Off Balance -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:id="@+id/appwidget_coff_balance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--"
            android:textColor="#03DAC6"
            android:textSize="36sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/appwidget_coff_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="C-Off Days"
            android:textColor="#CCCCCC"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Footer: Last Synced -->
    <TextView
        android:id="@+id/appwidget_last_synced"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Last Synced: Never"
        android:textColor="#999999"
        android:textSize="10sp"
        android:gravity="center" />

</LinearLayout>
